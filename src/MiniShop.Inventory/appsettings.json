// ==================================================================================================
// FILE: src/MiniShop.Inventory/appsettings.json
// Base configuration of the Inventory service, loaded by WebApplication.CreateBuilder in Program.cs.
// .NET's JSON configuration reader accepts // comments (plain JSON does not), so we can explain each setting.
// Later sources override these values: appsettings.{Environment}.json, then environment variables
// (a double underscore means a nested key, e.g. RabbitMq__Host=rabbitmq in Docker compose), then args.
// Read next: appsettings.Development.json
// ==================================================================================================
{
  "Logging": {
    "LogLevel": {
      // Our own code logs at Information and above.
      "Default": "Information",
      // ASP.NET Core, EF Core and MassTransit are very chatty at Information (every request, every SQL
      // statement, every bus event), so we only show their warnings and errors to keep the console readable.
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "MassTransit": "Warning"
    }
  },
  // Host header filtering: "*" accepts any host name (fine for a local demo behind no reverse proxy).
  "AllowedHosts": "*",
  // Path of the SQLite file owned by this service (relative to the working directory). Read in Program.cs.
  "Database": { "Path": "data/inventory.db" },
  // RabbitMQ connection (bound to RabbitMqOptions). guest/guest only works on localhost: a demo default,
  // never for production.  Docker compose overrides Host with the broker's container name.
  "RabbitMq": { "Host": "localhost", "Port": 5672, "Username": "guest", "Password": "guest" },
  // The Development-only control plane (/demo/* and /diagnostics/*).  OFF by default, so a production
  // deployment never exposes it by accident; appsettings.Development.json and compose switch it on.
  // Token = the shared secret the Web sends in the X-Demo-Token header (local demo only).
  "Demo": { "Enabled": false, "Token": "minishop-dev" }
}
