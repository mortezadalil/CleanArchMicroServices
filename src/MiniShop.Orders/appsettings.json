// ==================================================================================================
// appsettings.json - base configuration of the Orders service (all environments).
//
// .NET's JSON configuration reader accepts // comments, so this file is documented inline.
// Override order (later wins): this file → appsettings.{Environment}.json → environment variables
// (e.g. RabbitMq__Host=rabbitmq in infra/compose.yaml; "__" means ":" i.e. a nested key) → command line.
//
// Read next: appsettings.Development.json, then Saga/SagaOptions.cs.
// ==================================================================================================
{
  // Log verbosity per category. "Information" for our own code; noisy framework categories are raised
  // to "Warning" so the console shows the saga's story instead of every SQL statement or AMQP frame.
  "Logging": {
    "LogLevel": {
      // Everything not listed below.
      "Default": "Information",
      // Request routing / Kestrel internals.
      "Microsoft.AspNetCore": "Warning",
      // SQL commands executed by EF Core (set to "Information" to see every query while debugging).
      "Microsoft.EntityFrameworkCore": "Warning",
      // Bus start/stop, endpoint and retry chatter.
      "MassTransit": "Warning"
    }
  },
  // Host header filtering: "*" accepts any host name. Fine for a local demo behind no proxy.
  "AllowedHosts": "*",
  // Where orders.db lives. Relative to the working directory when using `dotnet run`;
  // compose.yaml overrides it with /data/orders.db on a named volume.
  "Database": { "Path": "data/orders.db" },
  // RabbitMQ connection (bound to RabbitMqOptions). "guest/guest" only works for localhost connections
  // in RabbitMQ's default config; compose overrides Host with "rabbitmq" (the service name on the network).
  "RabbitMq": { "Host": "localhost", "Port": 5672, "Username": "guest", "Password": "guest" },
  // Saga timeouts (bound to SagaOptions). Seconds, kept short so students can watch them fire.
  "Saga": {
    // Wait this long for Inventory to answer ReserveStock, then compensate with ReleaseStock.
    "StockTimeoutSeconds": 20,
    // Wait this long for Payments to answer ChargeWallet, then send CancelPayment (S10, S13).
    "PaymentTimeoutSeconds": 20,
    // Wait this long for StockReleased / PaymentCancelled before re-sending the compensation command.
    "CompensationTimeoutSeconds": 8,
    // After this many unanswered compensation commands the order goes to RequiresAttention (S12).
    "MaxCompensationAttempts": 3
  },
  // Development-only control plane (/demo/* and /diagnostics/*). OFF by default, so a production
  // deployment never exposes fault injection or data reset. appsettings.Development.json and
  // compose.yaml switch it on. Token = value expected in the X-Demo-Token header (local demo only).
  "Demo": { "Enabled": false, "Token": "minishop-dev" }
}
