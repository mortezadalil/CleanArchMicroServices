@*
    =================================================================================================
     ReplayPlayer.razor  —  step through an order's recorded history like a video
    -------------------------------------------------------------------------------------------------
     Event Replay: steps through the RECORDED timeline of an order (play / pause / previous / next /
     speed).  It only re-shows stored records and their state snapshots; it never re-executes commands.

     Why "never re-executes"?  Replaying by sending the messages again would charge wallets and
     reserve stock a second time.  Here we only look at what was recorded: each telemetry record may
     carry a snapshot of the owner's state taken at that moment, and the player shows it.

     What the student sees on screen:
       Player buttons (first / previous / play-pause / next), a speed selector, "step i / n", a slider,
       the current record (kind, service, time, detail, recorded state snapshot), and the full list of
       steps (done ones dimmed, current one highlighted; click a step to jump to it).

     Data source:
       Only the Events parameter (the order's event audit from the Web's read model, loaded by
       DeveloperPage).  No service is called.

     Read next: Developer/FaultPanel.razor.
    =================================================================================================
*@
@* IDisposable: Blazor calls Dispose when the component is removed, so we can stop a running playback. *@
@implements IDisposable

<div class="panel">
    <h3>Replay</h3>
    @if (Events.Count == 0) { <p class="muted">Select an order with recorded events.</p> }
    else
    {
        @* ---- player controls ------------------------------------------------------------------------ *@
        <div class="row">
            <button class="btn small" @onclick="First">⏮</button>
            <button class="btn small" @onclick="Prev">◀</button>
            <button class="btn small" @onclick="TogglePlay">@(_playing ? "⏸ pause" : "▶ play")</button>
            <button class="btn small" @onclick="Next">▶|</button>
            @* @bind on a <select>: the chosen option's value is converted to double and stored in _speed. *@
            <label class="small">speed <select @bind="_speed"><option value="0.5">0.5×</option><option value="1">1×</option><option value="2">2×</option><option value="5">5×</option></select></label>
            <span class="small muted">step @(_index + 1) / @Events.Count</span>
        </div>
        @* The slider: @oninput fires continuously while dragging (unlike @onchange, which fires on release). *@
        <input type="range" min="0" max="@(Events.Count - 1)" value="@_index" @oninput="OnSlider" style="width:100%" />
        @* ---- the current step ----------------------------------------------------------------------- *@
        <div class="replay-step">
            <p><span class="@Fmt.KindClass(Current.Kind)">@Current.Kind</span> <b>@Current.Service</b> <span class="mono muted">@Fmt.Time(Current.OccurredAtUtc)</span></p>
            <p>@Current.Detail</p>
            @if (Current.SnapshotJson is not null)
            {
                <details open><summary>state at this step (recorded snapshot, not a live query)</summary><pre>@TimelineView.Pretty(Current.SnapshotJson)</pre></details>
            }
            else { <p class="muted small">no state snapshot recorded for this step</p> }
        </div>
        @* ---- list of all steps (clickable) ------------------------------------------------------------ *@
        <ol class="steps compact">
            @for (var i = 0; i < Events.Count; i++)
            {
                // Copy the loop variable!  The lambda below runs later, when i would already be
                // Events.Count; idx is a fresh variable per iteration, so each item jumps to its own step.
                var idx = i;
                <li class="@(idx == _index ? "current" : idx < _index ? "done" : "")" @onclick="() => _index = idx">@Events[idx].Kind <small class="muted">@Events[idx].Service</small></li>
            }
        </ol>
    }
</div>

@code {
    /// <summary>The recorded audit records of one order, oldest first.</summary>
    [Parameter] public IReadOnlyList<EventAudit> Events { get; set; } = [];
    // Position in Events of the step being shown.
    private int _index;
    // True while auto-play runs.
    private bool _playing;
    // Playback speed factor chosen in the <select> (2 = twice as fast).
    private double _speed = 1;
    // Cancels the auto-play loop (pause button or component disposal).
    private CancellationTokenSource? _cts;

    /// <summary>When the parent passes a shorter list (another order), keep the index inside the list.</summary>
    protected override void OnParametersSet() { if (_index >= Events.Count) _index = Math.Max(0, Events.Count - 1); }

    // The record at the current position.
    private EventAudit Current => Events[_index];
    // Slider moved: the new position arrives as text in ChangeEventArgs.Value.
    private void OnSlider(ChangeEventArgs e) => _index = int.TryParse(e.Value?.ToString(), out var i) ? i : 0;
    // Navigation buttons, clamped so the index never leaves the list.
    private void First() => _index = 0;
    private void Prev() => _index = Math.Max(0, _index - 1);
    private void Next() => _index = Math.Min(Events.Count - 1, _index + 1);

    /// <summary>
    /// Play / pause.  Playing starts a background loop that advances one step at a time and asks
    /// Blazor to re-render after each step.
    /// </summary>
    private void TogglePlay()
    {
        // Pause: cancel the loop (its Task.Delay throws and the loop ends).
        if (_playing) { _cts?.Cancel(); _playing = false; return; }
        _playing = true;
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        // Run the loop in the background so the click handler returns immediately.
        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested && _index < Events.Count - 1)
            {
                // real timestamps drive the pace: wait the actual gap between records, scaled by speed (capped at 3s)
                var gap = Events[_index + 1].OccurredAtUtc - Events[_index].OccurredAtUtc;
                // Clamp: at least 200 ms so every step is visible, at most 3 s so long waits stay watchable.
                var wait = TimeSpan.FromMilliseconds(Math.Clamp(gap.TotalMilliseconds / _speed, 200, 3000));
                await Task.Delay(wait, token);
                _index++;
                // We are on a background thread: StateHasChanged must be marshalled to the
                // component's render context with InvokeAsync, then the diff is pushed over SignalR.
                await InvokeAsync(StateHasChanged);
            }
            // Reached the last step: show the play button again.
            _playing = false;
            await InvokeAsync(StateHasChanged);
        }, token);
    }

    /// <summary>Stop playback when the component goes away, so the loop does not keep running.</summary>
    public void Dispose() => _cts?.Cancel();
}
