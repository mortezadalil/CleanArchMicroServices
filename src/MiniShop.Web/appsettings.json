// ==================================================================================================
// FILE: src/MiniShop.Web/appsettings.json
//
// Base configuration of MiniShop.Web, used in EVERY environment.  .NET's JSON configuration provider
// accepts // comments, so we use them to explain each setting.
// Values are layered: appsettings.json < appsettings.{Environment}.json < environment variables.
// In Docker, infra/compose.yaml overrides several values with environment variables, written with a
// double underscore for nesting, e.g. Services__Orders=http://orders:8080 replaces Services:Orders.
//
// Read next: appsettings.Development.json, then Program.cs (where each section is read).
// ==================================================================================================
{
  // Minimum log level per category.  Our own code logs at Information; the frameworks are noisy at
  // Information (every HTTP request, every SQL command, every RabbitMQ message), so we raise them to
  // Warning to keep the console readable for students.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "MassTransit": "Warning"
    }
  },
  // Host filtering: accept requests for any host name (fine for a local teaching setup).
  "AllowedHosts": "*",
  // Path of readmodel.db, the ONLY database the Web owns (CQRS read side).  Relative paths are relative
  // to the working directory.  compose.yaml sets /data/readmodel.db (a Docker volume).
  "Database": { "Path": "data/readmodel.db" },
  // How MassTransit connects to RabbitMQ (read by ConfigureRabbitMqHost).  guest/guest is the RabbitMQ
  // default account, which only works from localhost or inside the compose network: demo values only.
  "RabbitMq": { "Host": "localhost", "Port": 5672, "Username": "guest", "Password": "guest" },
  // Base URLs used by ServiceClients (bound to the ServiceUrls class).  Remember: the Web never opens
  // another service's database.  These URLs are used ONLY for the POST /api/orders command gateway,
  // the health polling (/health/ready) and the Development-only control plane / read-only diagnostics.
  "Services": {
    // Orders API: POST /api/orders (checkout), /demo/*, /diagnostics/*.
    "Orders": "http://localhost:5101",
    // Inventory API: health, /demo/* (set stock, reset), /diagnostics/*.
    "Inventory": "http://localhost:5102",
    // Payments API: health, /demo/* (set wallet, reset), /diagnostics/*.
    "Payments": "http://localhost:5103",
    // RabbitMQ management HTTP API: queue depths for the Service Graph / projection lag (S08), and the
    // queue purge done by "Reset demo data".  Infrastructure telemetry, not a domain dependency.
    "RabbitMqManagement": "http://localhost:15672",
    // Optional helper that can stop/start containers (S04, "RabbitMQ goes down").  Empty = not available,
    // the Scenario Lab then asks you to stop the broker by hand.
    "Runner": "",
    // How scenario S09 restarts Orders: "Bus" = restart only its MassTransit bus in-process (dotnet run);
    // "Crash" = let the process exit and Docker restart the container (compose sets this).
    "OrdersRestartMode": "Bus"
  },
  // Development control plane (/demo/* endpoints, fault injection, Scenario Lab HTTP API).
  // Enabled = false here, so in Production those routes do not even exist.  appsettings.Development.json
  // switches it on.  Token = value every caller must send in the X-Demo-Token header (a demo secret,
  // not real security: never expose the control plane outside localhost).
  "Demo": { "Enabled": false, "Token": "minishop-dev" }
}
