<component name="ProjectRunConfigurationManager">
  <!-- Shared JetBrains Rider run configuration (committed on purpose, .idea/ is not).
       Starts ONLY src/MiniShop.Inventory (launch profile: Development, http://localhost:5102).
       MiniShop is four services that work only TOGETHER (+ RabbitMQ on localhost:5672): an order needs
       Web, Orders, Inventory and Payments at the same time. For normal debugging use the compound
       "MiniShop - Run ALL services" instead; use this one only to restart a single service while the
       other three are already running. -->
  <configuration default="false" name="Inventory only (5102)" type="LaunchSettings" factoryName=".NET Launch Settings Profile" folderName="Single service only (needs the other 3 running)">
    <option name="LAUNCH_PROFILE_PROJECT_FILE_PATH" value="$PROJECT_DIR$/src/MiniShop.Inventory/MiniShop.Inventory.csproj" />
    <option name="LAUNCH_PROFILE_TFM" value="net10.0" />
    <option name="LAUNCH_PROFILE_NAME" value="MiniShop.Inventory" />
    <option name="USE_EXTERNAL_CONSOLE" value="0" />
    <option name="USE_MONO" value="0" />
    <option name="RUNTIME_ARGUMENTS" value="" />
    <option name="GENERATE_APPLICATIONHOST_CONFIG" value="1" />
    <option name="SHOW_IIS_EXPRESS_OUTPUT" value="0" />
    <option name="SEND_DEBUG_REQUEST" value="1" />
    <option name="ADDITIONAL_IIS_EXPRESS_ARGUMENTS" value="" />
    <method v="2">
      <option name="Build" />
    </method>
  </configuration>
</component>
